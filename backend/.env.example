# ============================================================
# Brain Tumor MRI Classification — Backend Environment Example
# ============================================================
# Copy this file to .env and fill in the values.
# .env is gitignored; never commit real secrets.

# ------------------------------------------------------------
# Gemini AI  (REQUIRED for Part 2+ features)
# ------------------------------------------------------------

# Your Google Gemini API key.
# Obtain one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model identifier.
# Default: gemini-2.5-flash  (stable, multimodal — text, image, PDF)
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------
# File uploads
# ------------------------------------------------------------

# Maximum accepted upload size in megabytes.
MAX_UPLOAD_SIZE_MB=20

# ------------------------------------------------------------
# CNN Model
# ------------------------------------------------------------

# Absolute or relative path to the SmallCNN checkpoint.
# Default (when unset): <backend_root>/models/cnn_baseline_best.pth
MODEL_PATH=models/cnn_baseline_best.pth

# Inference device. Leave empty for auto-detection (CUDA if available, else CPU).
# Valid values: cpu | cuda | cuda:0
DEVICE=

# ------------------------------------------------------------
# CORS
# ------------------------------------------------------------

# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------
# Server (used when starting with uvicorn via scripts)
# ------------------------------------------------------------

HOST=0.0.0.0
PORT=8000
